{
  "crons": [
    {
      "path": "/api/scrape/check",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/scrape/check.ts": {
      "maxDuration": 60
    }
  },
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
